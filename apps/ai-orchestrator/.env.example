# Database (same Postgres the backend uses)
DATABASE_URL="postgresql://soar:soar_password@localhost:5432/soar_platform"

# Vector store
QDRANT_URL="http://localhost:6333"

# Embeddings
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# LLM — Ollama serves an OpenAI-compatible endpoint by default.
# Install Ollama, then: ollama pull llama3.1:8b-instruct-q4_K_M
LLM_PROVIDER="ollama"
LLM_BASE_URL="http://localhost:11434/v1"
LLM_MODEL="llama3.1:8b-instruct-q4_K_M"

# ── Threat Intelligence ─────────────────────────────────────────────────────
# All providers are optional. The agent degrades gracefully (UNKNOWN verdict,
# never CLEAN) when a provider's key is absent or the service is unreachable.
THREAT_INTEL_ENABLED=true

# VirusTotal (supports IPv4, IPv6, Domain, URL, MD5, SHA1, SHA256)
VIRUSTOTAL_API_KEY=""
VIRUSTOTAL_BASE_URL="https://www.virustotal.com/api/v3"
VIRUSTOTAL_TIMEOUT=5.0

# AbuseIPDB (supports IPv4, IPv6)
ABUSEIPDB_API_KEY=""
ABUSEIPDB_BASE_URL="https://api.abuseipdb.com/api/v2"
ABUSEIPDB_TIMEOUT=5.0

# MISP (supports all IOC types)
MISP_URL=""
MISP_API_KEY=""
MISP_TIMEOUT=5.0
MISP_VERIFY_TLS=true    # set false only for self-signed-cert dev instances

# AlienVault OTX (supports IPv4, IPv6, Domain)
OTX_API_KEY=""
OTX_BASE_URL="https://otx.alienvault.com/api/v1/indicators"
OTX_TIMEOUT=5.0

# Threat intel engine tuning (defaults suit most deployments)
THREAT_INTEL_CACHE_ENABLED=true
THREAT_INTEL_CACHE_TTL=3600         # seconds per-IOC per-provider
THREAT_INTEL_MAX_CONCURRENCY=3      # parallel IOC analyses per alert
THREAT_INTEL_RETRY_COUNT=2          # retries on transient HTTP errors
THREAT_INTEL_RETRY_BACKOFF_SECONDS=0.5
THREAT_INTEL_MAX_IOCS_PER_ALERT=25  # cap to avoid unbounded provider cost

# Decision policy thresholds (0-100 risk score)
RISK_AUTO_RESPONSE_THRESHOLD=30.0
RISK_HUMAN_APPROVAL_THRESHOLD=70.0

# Server
API_PORT=8000
