# Database (same Postgres the backend uses)
DATABASE_URL="postgresql://soar:soar_password@localhost:5432/soar_platform"

# Vector store
QDRANT_URL="http://localhost:6333"

# Embeddings
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

# LLM — Ollama serves an OpenAI-compatible endpoint by default.
# Install Ollama, then: ollama pull qwen2.5:3b
# IMPORTANT: LLM_MODEL must exactly match a tag `ollama list` shows on your
# machine — pulling a different quantization/tag than this default will
# 404 every LLM call (verified: this is a real failure mode, not
# hypothetical). Default here is a 3B model rather than an 8B one because a
# dev machine with ~3GB free RAM alongside the rest of the stack
# (Postgres/Wazuh/n8n/backend/frontend/worker) measured real, repeated
# OOM/timeout on an 8B q4 model; a real direct /v1/chat/completions call
# against qwen2.5:3b completed in ~20s. Use a larger model if your machine
# has the RAM for it.
LLM_PROVIDER="ollama"
LLM_BASE_URL="http://localhost:11434/v1"
LLM_MODEL="qwen2.5:3b"
# Only needed for a gateway/provider that requires bearer-token auth (e.g.
# Bifrost fronting remote vLLM/llama.cpp nodes) — leave unset for Ollama,
# which needs none. Never commit a real value here; set it in .env only.
LLM_API_KEY=
# CPU-only inference can genuinely take 60-90s+ per completion — 120s is a
# safer default than a typical 30s HTTP timeout, which would make every
# real LLM call fail its timeout and fall back, even when Ollama is
# working correctly.
LLM_TIMEOUT_SECONDS=120.0

# --- Bifrost -> vLLM -> Gemma target architecture ---
# No code change needed to switch: llm/llama_provider.py already speaks
# plain OpenAI-compatible /chat/completions (see its own docstring) — it
# works unmodified against Ollama, a bare vLLM OpenAI-compatible server, or
# a gateway like Bifrost fronting one. LLM_PROVIDER above is a label only
# (nothing branches on its value) — switching providers is exactly these
# four lines. To switch, comment out the three LLM_BASE_URL/LLM_MODEL/
# LLM_API_KEY lines above and uncomment these, filled in with your real
# Bifrost endpoint (ask whoever runs it for the exact base URL, the model
# name it routes to Gemma as, and its bearer token):
# LLM_PROVIDER="bifrost"
# LLM_BASE_URL="https://your-bifrost-host/v1"
# LLM_MODEL="gemma-4-26b"
# LLM_API_KEY="your-bifrost-bearer-token"

# Threat intel (Phase 2 — ThreatIntelAgent) — every provider degrades to
# NOT_CONFIGURED (never a fabricated result) if its key is unset. MISP is
# self-hosted via infra/docker/docker-compose.yml. See
# apps/backend/.env.example for how to fetch the automation API key after
# first boot (same key works here) — note it rotates on every MISP
# container recreate (docker compose up recreates it), so re-fetch with
# `docker compose exec misp-core /var/www/MISP/app/Console/cake User change_authkey 1`
# whenever lookups start failing with an auth error.
# Which providers are queried (comma-separated: virustotal, otx, misp, abuseipdb). A provider left out is not
# called and not reported; to use only the self-hosted MISP set THREAT_INTEL_PROVIDERS=misp.
THREAT_INTEL_PROVIDERS="virustotal,otx,misp,abuseipdb"
MISP_URL="https://localhost:8443"
MISP_API_KEY=""
MISP_TIMEOUT=10.0
MISP_VERIFY_TLS=false
MISP_RATE_LIMIT_PER_MINUTE=0

VIRUSTOTAL_API_KEY=""
VIRUSTOTAL_BASE_URL="https://www.virustotal.com/api/v3"
VIRUSTOTAL_TIMEOUT=10.0
# VirusTotal's public free-tier limit — raise if you have a paid key. 0 = unlimited.
VIRUSTOTAL_RATE_LIMIT_PER_MINUTE=4

OTX_API_KEY=""
OTX_BASE_URL="https://otx.alienvault.com/api/v1/indicators"
OTX_TIMEOUT=10.0
OTX_RATE_LIMIT_PER_MINUTE=0

# Bonus 4th provider, not required by the Phase 2 spec but wired the same way.
ABUSEIPDB_API_KEY=""
ABUSEIPDB_BASE_URL="https://api.abuseipdb.com/api/v2"
ABUSEIPDB_TIMEOUT=10.0
ABUSEIPDB_RATE_LIMIT_PER_MINUTE=0

# Retry/backoff (transient failures: 408/429/500/502/503/504, timeouts,
# connection errors — never 401/403/404 or other permanent errors).
THREAT_INTEL_RETRY_COUNT=2
THREAT_INTEL_RETRY_BACKOFF_SECONDS=0.5

# Redis-backed per-IOC result cache — same Redis already provisioned in
# infra/docker/docker-compose.yml (REDIS_URL defaults to that instance).
REDIS_URL="redis://localhost:6379/0"
THREAT_INTEL_CACHE_ENABLED=true
THREAT_INTEL_CACHE_TTL=86400

THREAT_INTEL_MAX_CONCURRENCY=5
THREAT_INTEL_MAX_IOCS_PER_ALERT=25

BACKEND_URL="http://localhost:4000"
# Phase 5.8 — service-to-service credential for the orchestrator callback
# (POST /api/v1/webhooks/orchestrator/callback). Mint with
# `npm run mint:orchestrator-token` in apps/backend, paste the printed JWT
# here. Empty = the callback is sent with no Authorization header, which
# the backend's orchestratorAuth middleware now rejects with 401.
BACKEND_SERVICE_TOKEN=

# RagAgent — retrieval/re-ranking tunables. Vector search itself reuses
# BACKEND_URL above (POST /api/v1/knowledge/search) — no separate URL.
RAG_TOP_K=5
RAG_FINAL_TOP_K=3
# Empirically calibrated against the real playbook corpus + bge-small-en-v1.5
# (see rag_agent/config.py) — 0.5 discarded every real match regardless of
# relevance; real matches score ~0.39-0.43, unrelated queries ~0.30-0.33.
RAG_RELEVANCE_THRESHOLD=0.35
RAG_VECTOR_SEARCH_TIMEOUT_S=10.0
RAG_VECTOR_SEARCH_MAX_RETRIES=2

# Decision policy — DecisionAgent's PolicyEngine (0-100 risk score, 0-1 confidence)
RISK_AUTO_RESPONSE_THRESHOLD=30.0
RISK_HUMAN_APPROVAL_THRESHOLD=70.0
DECISION_CONFIDENCE_FLOOR=0.6
DECISION_POLICY_REGISTRY_VERSION="policy-registry@v1"
DECISION_RESULT_EXPIRATION_MINUTES=30

# Emergency Override Policy — absolute, temporary, org-wide. Leave inactive
# unless a declared incident requires it (see decision_agent/policy_engine.py).
EMERGENCY_OVERRIDE_ACTIVE=false
EMERGENCY_OVERRIDE_OUTCOME="escalate"

# Time Window Policy — set true during a declared change freeze.
CHANGE_FREEZE_ACTIVE=false

# Jira notification — human-in-the-loop approval tickets for
# HUMAN_APPROVAL_REQUIRED decisions. Start with JIRA_MOCK_MODE=true (the
# default) to demo the full approval workflow without a real Jira account —
# it simulates ticket creation (SEC-101, SEC-102, ...) instead of calling the
# API. To hit a real Jira Cloud instance: set JIRA_MOCK_MODE=false,
# JIRA_ENABLED=true, and fill in the credentials below.
JIRA_ENABLED=false
JIRA_MOCK_MODE=true
JIRA_BASE_URL=""
JIRA_EMAIL=""
JIRA_API_TOKEN=""
JIRA_PROJECT_KEY="SEC"
JIRA_ISSUE_TYPE="Task"
JIRA_TIMEOUT_S=10.0

# Email notification — SMTP. Same mock-mode-first pattern as Jira above.
EMAIL_ENABLED=false
EMAIL_MOCK_MODE=true
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
EMAIL_FROM=""
SOC_EMAIL=""
EMAIL_TIMEOUT_S=10.0

# Microsoft Teams notification — Incoming Webhook URL from a Teams channel connector.
TEAMS_ENABLED=false
TEAMS_MOCK_MODE=true
TEAMS_WEBHOOK_URL=""
TEAMS_TIMEOUT_S=10.0

# LINE notification — LINE Messaging API (push message), NOT LINE Notify
# (discontinued). Requires a Messaging API channel's access token + the
# target user/group/room id to push to.
LINE_ENABLED=false
LINE_MOCK_MODE=true
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_TARGET_ID=""
LINE_TIMEOUT_S=10.0

# NotificationPolicy — which channels fire for a given DecisionResult (see
# notifications/notification_policy.py). Comma-separated.
NOTIFICATION_URGENT_PRIORITIES="P1"
NOTIFICATION_HIGH_SEVERITY_VALUES="high,critical"

# Server
API_PORT=8000
