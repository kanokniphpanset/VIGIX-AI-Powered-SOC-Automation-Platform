{
  "name": "@soar-platform/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "seed": "prisma db seed",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "runbooks:index": "ts-node scripts/indexRunbooksToQdrant.ts",
    "subtype:seed": "ts-node scripts/seedSubtypeKnowledge.ts",
    "policies:spread:seed": "ts-node scripts/seedSpreadResponsePolicies.ts",
    "e2e:mock-attacks": "ts-node --transpile-only scripts/e2e-mock-attacks.ts",
    "test": "jest"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^9.7.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "js-yaml": "^3.15.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.10",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^8.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
