DATABASE_URL="postgresql://soar:soar_password@localhost:5432/soar_platform"
BACKEND_PORT=4000
JWT_SECRET="replace-with-a-long-random-string"
AI_ORCHESTRATOR_URL="http://localhost:8000"
QDRANT_URL="http://localhost:6333"
# fake (default, deterministic) | llm (calls apps/ai-orchestrator's POST /recommendations/generate)
RECOMMENDATION_AGENT="fake"
N8N_URL="http://localhost:5678"
N8N_API_KEY="changeme"
# Used to build clickable links (ticket/approval) inside notification events — see
# docs/architecture/notification-event-contract.md. Points at the frontend, not the backend.
VIGIX_BASE_URL="http://localhost:5173"

# Notification Delivery (backend-native — see docs/architecture/notification-event-contract.md).
# Routing: which role receives which channel (two roles: SOC and IR_TEAM,
# plus the ADMIN system contact) — read directly by the backend. Leave any blank to leave that
# role/channel combination un-deliverable; nothing fails loudly, it's just skipped.
IR_TEAM_EMAIL=
SOC_EMAIL=
# System administration contact (Settings -> Notification can override; never an approver).
ADMIN_EMAIL=

# Discord — one global webhook (not per-role); the intended role is in the
# message text, not the destination. Create one at:
# Discord server -> Settings -> Integrations -> Webhooks -> New Webhook.
DISCORD_WEBHOOK_URL=

# Telegram — one global bot/chat (not per-role), same reasoning as Discord.
# Create a bot via @BotFather to get TELEGRAM_BOT_TOKEN; message the bot
# once, then call https://api.telegram.org/bot<token>/getUpdates to read
# back the chat id for TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email — SMTP. For Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587,
# EMAIL_SECURE=false, EMAIL_USER=<your gmail>, EMAIL_PASSWORD=<16-char App
# Password from https://myaccount.google.com/apppasswords — NOT your normal
# Gmail password, and requires 2-Step Verification to be enabled first.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_SECURE=false

# Wazuh Indexer — evidence source for Verification re-hunt (read-only queries; Wazuh never decides RESOLVED/NOT_RESOLVED).
# From the host:                 WAZUH_INDEXER_URL=https://localhost:9200  (+ WAZUH_INDEXER_TLS_SERVERNAME=wazuh.indexer)
# From a container on the Wazuh docker network: WAZUH_INDEXER_URL=https://wazuh.indexer:9200
# Leave blank to disable the automatic re-hunt (manual evidence entry remains as a labelled fallback).
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
# PEM root CA that signed the indexer certificate (wazuh-docker/single-node/config/wazuh_indexer_ssl_certs/root-ca.pem)
WAZUH_INDEXER_CA_PATH=
WAZUH_INDEXER_TLS_SERVERNAME=
# Dev only: skip TLS verification. Prefer WAZUH_INDEXER_CA_PATH.
WAZUH_INDEXER_INSECURE_TLS=false
WAZUH_INDEX_PATTERN=wazuh-alerts-4.x-*

# Re-hunt provider. Unset/"wazuh" = real Wazuh Indexer (WAZUH_INDEXER_*). "mock" = deterministic
# fixture provider over resources/mock-attacks (dev/test only; never NO_MATCH on failure).
REHUNT_PROVIDER=mock
WAZUH_INDEXER_INDEX_PATTERN=
WAZUH_REHUNT_TIMEOUT_MS=15000
# Optional JSON map: ip/domain/url/hash => arrays of searchable keyword/IP field names.
# Default fields must be verified against your deployment; text mappings fail safely.
WAZUH_REHUNT_IOC_FIELDS=
# Wazuh alert time field; validated against the live date mapping.
# Leave blank for timestamp with per-document @timestamp fallback, validated per index.
# A nonempty value explicitly restricts event time to that one mapped field.
WAZUH_REHUNT_TIMESTAMP_FIELD=
# REHUNT_MOCK_MODE="FIXTURE"   # FIXTURE | ERROR | TIMEOUT | INDEXER_UNAVAILABLE
