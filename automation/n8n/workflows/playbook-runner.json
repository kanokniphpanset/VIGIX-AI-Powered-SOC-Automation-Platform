{
  "name": "SOAR - Playbook Runner",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "soar/playbook-run",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Decision Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "soar-playbook-run"
    },
    {
      "parameters": {
        "workflowId": "={{ 'teams-notification' }}",
        "options": {}
      },
      "id": "call-teams",
      "name": "Notify Teams",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [500, 220]
    },
    {
      "parameters": {
        "workflowId": "={{ 'ticket-creation' }}",
        "options": {}
      },
      "id": "call-ticketing",
      "name": "Create Ticket",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [500, 400]
    }
  ],
  "connections": {
    "Decision Webhook": {
      "main": [
        [
          { "node": "Notify Teams", "type": "main", "index": 0 },
          { "node": "Create Ticket", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "notes": "Top-level playbook: fans out to the Teams-notification and ticket-creation sub-workflows. This is the workflow the backend's future N8nWorkflowEngineAdapter.ts (infrastructure/automation/) should call for every DecisionAgent output. Import teams-notification.json and ticket-creation.json first so their workflow IDs resolve, then update the workflowId fields above to match your n8n instance's actual IDs (n8n assigns new IDs on import)."
}
