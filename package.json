{
  "name": "soar-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Driven SOAR Automation Platform - monorepo root",
  "workspaces": [
    "apps",
    "apps/backend",
    "packages/*"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}